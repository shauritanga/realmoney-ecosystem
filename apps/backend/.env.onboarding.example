# Merge into your deployment configuration; never commit real credentials.
# Explicitly opt in ONLY for local synthetic-data testing. Ignored in production.
ONBOARDING_DEV_MODE=false
# At least 32 random bytes; required for live OTP hashes.
OTP_SECRET=
# Beem SMS credentials and approved sender ID.
BEEM_API_KEY=
BEEM_API_SECRET=
BEEM_SENDER_ID=
# Existing Selcom credentials must be enabled for IMT wallet name lookup.
# SELCOM_API_KEY, SELCOM_API_SECRET, SELCOM_BASE_URL
# Approved NIDA stakeholder integration behind your private HTTPS adapter.
VERIFICATION_BRIDGE_URL=
VERIFICATION_BRIDGE_TOKEN=
# Set approved texts (not development drafts) and the explicit release flag.
ACCOUNT_TERMS_TEXT=
PRIVACY_NOTICE_TEXT=
LEGAL_REVIEW_APPROVED=false
