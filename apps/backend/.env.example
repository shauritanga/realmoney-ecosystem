PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/realmoney_db"

# JWT Authentication
JWT_SECRET="replace_with_a_secure_random_jwt_secret_in_production"
JWT_EXPIRES_IN="7d"


# ClickPesa repayment collection (server-side only)
CLICKPESA_API_KEY=""
CLICKPESA_CLIENT_ID=""
# Required for webhooks. Enable canonical checksum in the ClickPesa application.
CLICKPESA_CHECKSUM_KEY=""

# Schema management. Defaults to "true", which auto-syncs the schema from the
# entities on every boot — convenient in development, but it also means the .sql
# files in src/database/migrations/ are never exercised locally. Set to "false" in
# production and apply those files by hand before deploying.
TYPEORM_SYNC="true"

# When promise-to-pay tracking went live, as an ISO timestamp. Promises whose
# deadline passed before this were made while nothing recorded outcomes at all, so
# the first sweep marks them BACKFILL_UNVERIFIED and excludes them from kept-rate
# rather than cratering the metric with a backlog nobody was measuring. Defaults to
# 2026-09-25; set it to the actual go-live date for this installation.
PTP_TRACKING_START="2026-09-25T00:00:00.000Z"
