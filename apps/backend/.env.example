PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/realmoney_db"

# JWT Authentication
JWT_SECRET="replace_with_a_secure_random_jwt_secret_in_production"
JWT_EXPIRES_IN="7d"

# Selcom Tanzania Gateway Credentials
SELCOM_BASE_URL="https://apigw.selcommobile.com/v1"
SELCOM_API_KEY="SELCOM_DEV_KEY_PLACEHOLDER"
SELCOM_API_SECRET="SELCOM_DEV_SECRET_PLACEHOLDER"
SELCOM_VENDOR="REALMONEY_TZ"

# ClickPesa repayment collection (server-side only)
CLICKPESA_API_KEY=""
CLICKPESA_CLIENT_ID=""
# Required for webhooks. Enable canonical checksum in the ClickPesa application.
CLICKPESA_CHECKSUM_KEY=""
